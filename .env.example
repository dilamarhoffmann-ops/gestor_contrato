# Variáveis de Ambiente - Template
# Copie este arquivo para .env e preencha com seus valores reais

# Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui

# AWS S3
VITE_AWS_ACCESS_KEY_ID=sua_access_key_aqui
VITE_AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui
VITE_AWS_REGION=sa-east-1
VITE_S3_BUCKET=nome-do-seu-bucket
